# Environment only: source code and data are mounted at execution time.
# Intended for GitHub's Linux x86_64 runners; not a native ARM image.
ARG UV_VERSION=0.8.14
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uvbin
FROM rocker/r-ver:4.3.2

ARG QUARTO_VERSION=1.3.353
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RENV_CONFIG_CACHE_ENABLED=false \
    HEALTH_REPORT_R_LIBRARY=/opt/health-report-r-library \
    R_LIBS_USER=/opt/health-report-r-library \
    PATH="/opt/health-report-venv/bin:/opt/tex/.TinyTeX/bin/x86_64-linux:${PATH}"

RUN test "$(uname -m)" = x86_64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl git xz-utils perl make g++ gfortran pkg-config libuv1-dev \
       libcurl4-openssl-dev libssl-dev libxml2-dev libfontconfig1-dev libfreetype6-dev \
       libpng-dev libjpeg-dev libtiff-dev libharfbuzz-dev libfribidi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uvbin /uv /uvx /usr/local/bin/
RUN uv python install 3.11.6 \
    && uv venv --python 3.11.6 /opt/health-report-venv
COPY scripts/health_pipeline/requirements.lock.txt /opt/build/requirements.lock.txt
RUN uv pip install --python /opt/health-report-venv/bin/python -r /opt/build/requirements.lock.txt \
    && uv pip check --python /opt/health-report-venv/bin/python

RUN curl --fail --show-error --location --retry 5 --retry-all-errors \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
      -o /tmp/request-quarto.tar.gz \
    && mkdir -p /opt/quarto \
    && tar -xzf /tmp/request-quarto.tar.gz -C /opt/quarto --strip-components=1 \
    && ln -s /opt/quarto/bin/quarto /usr/local/bin/quarto \
    && rm /tmp/request-quarto.tar.gz

WORKDIR /opt/r-build
COPY renv.lock ./renv.lock
COPY workflow/restore_r.R ./workflow/restore_r.R
RUN Rscript workflow/restore_r.R \
    && mv .r-library /opt/health-report-r-library \
    && chmod -R a+rX /opt/health-report-r-library

COPY workflow/install_request_tex.sh /opt/build/install_request_tex.sh
RUN bash /opt/build/install_request_tex.sh

# Keep the environment recipe/locks in the image for inspection.
COPY Dockerfile.request /opt/build/Dockerfile.request
RUN cp /opt/r-build/renv.lock /opt/build/renv.lock \
    && python --version && snakemake --version && Rscript --version && quarto --version

WORKDIR /workspace
CMD ["snakemake", "--cores", "2"]
