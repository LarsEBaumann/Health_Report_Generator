{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health report request v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "audience", "datasets", "formats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "audience": {"enum": ["researcher", "public_health_expert", "general_public"]},
    "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["html", "pdf"]}}
  }
}
